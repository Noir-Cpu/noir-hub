---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import archivoWdth from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import plexSans from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import Mark from "../components/Mark.astro";

interface Props {
  title: string;
  description: string;
  /** Path of the social card, e.g. /og/home.png */
  image?: string;
  jsonLd?: object;
  noindex?: boolean;
}
const { title, description, image = "/og/home.png", jsonLd, noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path === "/" ? "/" : path.replace(/\/$/, ""), Astro.site).href;
const fullTitle = title.includes("NOIR") ? title : `${title} | John Balogun, NOIR`;
const imageUrl = new URL(image, Astro.site).href;
const nav = [
  { href: "/#cases", label: "Cases" },
  { href: "/status", label: "Status" },
  { href: "/#about", label: "About" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoWdth} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexSans} as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#efebe2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#110f0d" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="John Balogun, NOIR" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="frame">
        <a class="brand" href="/" aria-label="John Balogun, NOIR: home">
          <Mark />
          <span>John Balogun</span>
        </a>
        <nav aria-label="Primary">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={path === n.href ? "page" : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="foot">
      <div class="frame">
        <p class="mono">John Balogun, NOIR</p>
        <p class="mono muted">Evidence, not claims. Site REV 0.1</p>
        <p class="mono"><a href="https://github.com/Noir-Cpu">github.com/Noir-Cpu</a></p>
      </div>
    </footer>
  </body>
</html>
