---
import Base from "../layouts/Base.astro";
---
<Base title="Not found" description="This page is not in the file. Return to John Balogun's NOIR case index." noindex>
  <div class="frame lost">
    <section class="casehead" aria-labelledby="t">
      <div class="strip"><span class="badge">[ 404 ]</span><span class="label">File not found</span></div>
      <h1 id="t">404</h1>
      <p class="lede">There is no case file at this address. It may have moved, or never existed.</p>
      <p style="margin-top:1.5rem"><a href="/#cases">Go to the case index</a> or <a href="/">back to the start</a>.</p>
    </section>
  </div>
</Base>
